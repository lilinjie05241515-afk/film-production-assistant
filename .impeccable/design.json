      "css": ".ds-primary{font-family:\"Segoe UI\",\"Microsoft YaHei\",sans-serif;font-size:13px;line-height:1.5;border-radius:7px;padding:8px 13px;cursor:pointer;background:var(--accent,#d0b47d);color:var(--accent-ink,#171713);border:1px solid transparent;padding:8px 13px}.ds-primary:hover{filter:brightness(1.08)}.ds-primary:active{transform:scale(.985)}.ds-primary:focus-visible{outline:2px solid var(--accent,#d0b47d);outline-offset:3px}.ds-primary:disabled{opacity:.5;cursor:default}"
    },
    {
      "name": "次操作",
