      "html": "<label class=\"ds-field\">具体用途<input class=\"ds-input\" placeholder=\"例如：基础形象\" /></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:6px;color:var(--muted,#a2a6a8);font:12px \"Segoe UI\",\"Microsoft YaHei\",sans-serif}.ds-input{border:1px solid var(--line,#303437);border-radius:7px;padding:8px 10px;background:var(--surface,#1b1e20);color:var(--ink,#eeede8);font:14px \"Segoe UI\",\"Microsoft YaHei\",sans-serif;caret-color:var(--accent,#d0b47d)}.ds-input::placeholder{color:var(--muted,#a2a6a8);opacity:1}.ds-input:focus-visible{outline:2px solid var(--accent,#d0b47d);outline-offset:3px}"
    },
    {
