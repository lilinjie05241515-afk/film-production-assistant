      "html": "<section class=\"ds-panel\"><h2>资料设置</h2><p>核对当前项目和准确版本。</p></section>",
      "css": ".ds-panel{background:var(--surface,#1b1e20);color:var(--ink,#eeede8);border:1px solid var(--line,#303437);border-radius:12px;padding:22px;font:14px/1.65 \"Segoe UI\",\"Microsoft YaHei\",sans-serif}.ds-panel h2{margin:0 0 15px;font-size:17px;font-weight:600;line-height:1.45}.ds-panel p{margin:0;color:var(--muted,#a2a6a8)}"
    },
    {
      "name": "准确版本阅读抽屉",
