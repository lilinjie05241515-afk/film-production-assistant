      "html": "<span class=\"ds-badge\">候选</span> <span class=\"ds-badge ds-good\">当前采用</span> <span class=\"ds-badge ds-warn\">待核对</span>",
      "css": ".ds-badge{display:inline-block;border-radius:5px;padding:3px 8px;font:11px/1.65 \"Segoe UI\",\"Microsoft YaHei\",sans-serif;background:var(--hover,#24282a);color:var(--muted,#a2a6a8)}.ds-good{background:var(--good-bg,#22362d);color:var(--good,#a8c7b7)}.ds-warn{background:var(--warning-bg,#332c1f);color:var(--warning,#dbc38d)}"
    },
