      "html": "<button class=\"ds-text\">文字操作</button>",
      "css": ".ds-text{font-family:\"Segoe UI\",\"Microsoft YaHei\",sans-serif;font-size:13px;line-height:1.5;border-radius:7px;padding:8px 13px;cursor:pointer;background:transparent;color:var(--accent,#d0b47d);border:1px solid transparent;padding:5px}.ds-text:hover{background:transparent}.ds-text:active{transform:scale(.985)}.ds-text:focus-visible{outline:2px solid var(--accent,#d0b47d);outline-offset:3px}.ds-text:disabled{opacity:.5;cursor:default}"
    },
    {
      "name": "输入框",
      "kind": "input",
      "refersTo": "input",
