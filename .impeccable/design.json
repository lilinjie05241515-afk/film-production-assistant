      "html": "<nav class=\"ds-nav\" aria-label=\"主导航\"><button aria-current=\"page\">项目总览</button><button>创作任务</button></nav>",
      "css": ".ds-nav{display:grid;gap:7px}.ds-nav button{font-family:\"Segoe UI\",\"Microsoft YaHei\",sans-serif;font-size:13px;line-height:1.5;border-radius:7px;padding:8px 13px;cursor:pointer;text-align:left;padding:11px 12px;border:1px solid transparent;background:transparent;color:var(--muted,#a2a6a8)}.ds-nav button[aria-current=page]{background:var(--soft,#302b21);color:var(--accent,#d0b47d);font-weight:650}.ds-nav button:hover{background:var(--hover,#24282a);border-color:var(--line,#303437)}.ds-nav button:focus-visible{outline:2px solid var(--accent,#d0b47d);outline-offset:3px}.ds-nav button:active{transform:scale(.985)}"
    },
    {
      "name": "语义徽标",
      "kind": "chip",
      "refersTo": "badge",
