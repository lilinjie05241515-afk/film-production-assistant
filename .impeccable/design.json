      "css": ".ds-secondary{font-family:\"Segoe UI\",\"Microsoft YaHei\",sans-serif;font-size:13px;line-height:1.5;border-radius:7px;padding:8px 13px;cursor:pointer;background:var(--surface,#1b1e20);color:var(--ink,#eeede8);border:1px solid var(--line,#303437);padding:8px 13px}.ds-secondary:hover{background:var(--hover,#24282a)}.ds-secondary:active{transform:scale(.985)}.ds-secondary:focus-visible{outline:2px solid var(--accent,#d0b47d);outline-offset:3px}.ds-secondary:disabled{opacity:.5;cursor:default}"
    },
    {
