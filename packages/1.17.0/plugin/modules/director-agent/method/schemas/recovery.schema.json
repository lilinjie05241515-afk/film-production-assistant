{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:director-agent:v1:recovery",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "project_revision": {
      "type": "integer",
      "minimum": 0
    },
    "task": {
      "type": "object"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 0
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 0
    },
    "pending_submissions": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 0
    },
    "load_order": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "included": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 0
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "project_revision",
    "task",
    "artifacts",
    "decisions",
    "pending_submissions",
    "load_order",
    "included",
    "excluded",
    "checked_at"
  ]
}
