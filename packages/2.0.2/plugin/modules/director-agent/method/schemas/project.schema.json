{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:director-agent:v1:project",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "schema_version": {
      "const": "1.0"
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "current_revision": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "project_id",
    "schema_version",
    "root",
    "current_revision"
  ]
}
