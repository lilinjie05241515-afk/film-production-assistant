{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:director-agent:v1:checkpoint",
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "running",
        "blocked",
        "needs_revision",
        "submitted"
      ]
    },
    "completed": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "minProperties": 1
          },
          {
            "type": "array",
            "minItems": 1
          }
        ]
      },
      "minItems": 0
    },
    "remaining": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "minProperties": 1
          },
          {
            "type": "array",
            "minItems": 1
          }
        ]
      },
      "minItems": 0
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "drafts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "status",
    "remaining",
    "next_action",
    "drafts"
  ]
}
