{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:director-agent:v1:shot",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "shot_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "scene_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "beat_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "order_index": {
      "type": "integer",
      "minimum": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "script_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "performance": {
      "type": "object",
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "reaction": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "objective",
        "action",
        "reaction"
      ]
    },
    "blocking": {
      "type": "object",
      "properties": {
        "start_state": {
          "type": "string",
          "minLength": 1
        },
        "trajectory": {
          "type": "string",
          "minLength": 1
        },
        "end_state": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "start_state",
        "trajectory",
        "end_state"
      ]
    },
    "camera": {
      "type": "object",
      "properties": {
        "size": {
          "type": "string",
          "minLength": 1
        },
        "composition": {
          "type": "string",
          "minLength": 1
        },
        "movement": {
          "type": "string",
          "minLength": 1
        },
        "lens_equivalent_mm": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "size",
        "composition",
        "movement",
        "lens_equivalent_mm"
      ]
    },
    "timing": {
      "type": "object",
      "properties": {
        "estimated_seconds": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "start_trigger": {
          "type": "string",
          "minLength": 1
        },
        "end_trigger": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "estimated_seconds",
        "start_trigger",
        "end_trigger"
      ]
    },
    "editing": {
      "type": "object",
      "properties": {
        "cut_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "cut_reason"
      ]
    },
    "sound": {
      "type": "object",
      "properties": {
        "cues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "perspective": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "cues",
        "perspective"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "media_evidence_status": {
      "enum": [
        "not_generated",
        "not_viewed",
        "partially_viewed",
        "verified",
        "failed"
      ]
    }
  },
  "required": [
    "schema_version",
    "shot_id",
    "scene_id",
    "beat_id",
    "order_index",
    "purpose",
    "script_refs",
    "performance",
    "blocking",
    "camera",
    "timing",
    "editing",
    "sound",
    "dependencies",
    "media_evidence_status"
  ]
}
